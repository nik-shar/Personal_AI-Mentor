# EditorConfig — keeps every editor producing the same file shapes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks on purpose.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab