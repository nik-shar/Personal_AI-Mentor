# ==========================================
# Personal AI Mentor — Environment Configuration
# ==========================================

# Nebius OpenAI-Compatible LLM API Key
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Conversational model (Tier 2 — the mentor's voice layer).
# Wired into direct_response, synthesizer, and the fallback agent.
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# ---------------------------------------------------------------------------
# Chat engine — which runtime answers POST /api/chat
#   pi      the PI agent core, driven over its RPC mode
#           (orchestrator/pi_bridge.py). The migration target: the mentor's own
#           loop, tools, skills and guardrails.
#   python  the pre-migration LangGraph pipeline — the escape hatch for one
#           release (same ChatResponse contract, so no redeploy to flip back).
# Default: pi. It flipped only once `run_specialist` landed (api/tools.py);
# before that, leaving Python would have silently dropped roadmap, resume and
# LinkedIn-post work from chat. Read per request — no restart to change it.
# MENTOR_CHAT_ENGINE=python     # force the legacy pipeline
# MENTOR_SPECIALIST_TIMEOUT_MS=300000   # run_specialist may take minutes
#
# Bridge tuning — all optional, defaults shown:
# PI_TURN_TIMEOUT_SECONDS=420        slow turns (goal decomposition) are not cut short
# PI_SESSION_IDLE_TTL_SECONDS=1800   idle web sessions stop holding a Node process
# PI_ENTRY=pi/packages/coding-agent/dist/bundle/cli.js
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Crisis detection (PI core) — keyword backstop + an LLM disclosure classifier.
# The classifier fails open: a slow or broken call leaves the keywords and the
# always-on distress directive in place, and says so in the logs. The budget caps
# waiting, not the call, so a late verdict still enforces the support pointer.
# See docs/PI-Mentor Boundary.md §10.
# PI_CRISIS_CLASSIFIER=1            # 0 = keywords + baseline only
# PI_CRISIS_BUDGET_MS=1500          # wait for a pre-generation verdict (measured ~0.9s)
# PI_CRISIS_MODEL=nebius-classifier/Qwen/Qwen3-30B-A3B-Instruct-2507
# PI_CRISIS_DEBUG=1                 # log every verdict and its latency
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Timezone basis — the ONE timezone every calendar clock uses
#
# Slot labels in the day grid are wall-clock readings in this zone: "22:00"
# means 22:00 for you. Unset, the system uses the machine's own zone; set it
# explicitly when the mentor runs somewhere other than your clock (a server or
# a container), or every time it states will be off by that offset.
# MENTOR_TIMEZONE=Asia/Kolkata
# ---------------------------------------------------------------------------

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://nik:nik@localhost:5432/ai_companion

# Obsidian Vault Integration Settings
OBSIDIAN_VAULT_PATH=/path/to/your/Obsidian/Vault
OBSIDIAN_TOPIC_FOLDER=Learning/Topics
# Career folder: master_resume.yaml + per-application tailored resumes (job_hunter)
OBSIDIAN_CAREER_FOLDER=Career

# Job search integrations (job_hunter agent — all optional, fail-open)
# SERP_API_KEY=...              # SerpApi Google Jobs (primary source)
# JSEARCH_RAPIDAPI_KEY=...      # JSearch via RapidAPI (secondary source)
# TAVILY_API_KEY=...            # Tavily web search (fallback: DuckDuckGo)

# DNA Memory (dna_memory_redesign_v2.md)
# Async reflection writes memories after each chat turn (Phase 2)
DNA_REFLECTION_ENABLED=1
# Reasoner reads the DNA context document instead of the situation report (Phase 3)
USE_DNA_CONTEXT=0
# Model tier for DNA memory writes (reflection + compare/merge + consolidation).
# Defaults to the STRONG conversational tier (Qwen3-235B) while the organic
# memory base is being built. Switch to a cheaper tier later:
#   DNA_REFLECTION_MODEL=reasoning      # gpt-4o-mini (fast/cheap)
#   DNA_REFLECTION_MODEL=writer          # MiniMax-M3
#   DNA_REFLECTION_MODEL=conversational  # Qwen3-235B (default, strong)
# DNA_REFLECTION_MODEL=conversational

# ---------------------------------------------------------------------------
# Day log (Telegram) — recording what he is actually doing, as he does it
#
# The mentor's record of his real day, in his own words, from his phone. A
# one-line message between activities ("waking up", "starting my learning",
# "off to lunch", "going to sleep") is the lowest-friction record that still
# carries a timestamp — and the timestamp is what turns one-liners into
# durations, because a message that starts something closes whatever came before.
#
# Run it with:  scripts/run_telegram_listener.sh
# It LONG-POLLS Telegram (outbound only — no inbound port, no public URL), then
# POSTs each message to the local /api/chat, so the mentor's tools, memory and
# guardrails all apply exactly as they do on the web dashboard.
# The sidecar must be running for it to answer.
#
TELEGRAM_BOT_TOKEN=your_bot_token
# Who may talk to the mentor. Comma-separated, so a second device can be added.
# Mandatory: with no allowlist the listener refuses to start, because a stranger
# who finds the bot could make the mentor write to the calendar and memory.
# Falls back to TELEGRAM_CHAT_ID when unset.
TELEGRAM_ALLOWED_CHAT_IDS=your_chat_id
# TELEGRAM_CHAT_ID=your_chat_id            # the older single-id variable still works
# TELEGRAM_POLL_TIMEOUT_SECONDS=30         # how long Telegram holds an idle poll open
# TELEGRAM_CHAT_TIMEOUT_SECONDS=420        # a mentor turn can take minutes
# TELEGRAM_OFFSET_PATH=data/telegram_offset.json   # the ack cursor (gitignored)
# ---------------------------------------------------------------------------

# Code-Grounded Mentor (code-explorer toolkit, Shape-1)
# Extra workspace roots the mentor may READ/GREP/TEST (os.pathsep-separated).
# The mentor's own repo is always a root; add your other projects here.
# MENTOR_WORKSPACE_ROOTS=/home/nik/work/taskchain-orchestrator:/home/nik/work/other-project

# ---------------------------------------------------------------------------
# Tracing / observability (LangSmith Cloud — every LLM call in detail)
# ---------------------------------------------------------------------------
# Set LANGSMITH_API_KEY (https://smith.langchain.com → Settings → API keys) to
# enable tracing. orchestrator/tracing.py then forces LANGCHAIN_TRACING_V2=true,
# so EVERY LLM call (reasoner, synthesizer, agent scoring, request parse, DNA
# reflection, daily summary, consolidation, ...) is auto-captured with full
# prompts, outputs, token usage and latency — nested in a run tree under the
# per-turn "mentor_turn" run, with a "component:<name>" tag on each.
# LANGSMITH_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=ai-mentor     # project name in the LangSmith UI
# MENTOR_TRACING=on               # set to "off" to disable even with a key
# MENTOR_DEBUG=1                  # print a per-step latency + failure trace to
#                                 # the terminal every turn (no LangSmith needed)
